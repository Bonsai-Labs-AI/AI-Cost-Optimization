---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOUNDATIONS } from '../data/taxonomy.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Foundations — Agentic Coding Token Costs"
  description="The one-time setup that makes every technique measurable: instrument your spend and understand how you're billed."
>
  <section style="max-width: 820px;">
    <h1>Foundations</h1>
    <p style="color:var(--text-dim); font-size:1.08rem;">
      Two things to set up once, before any technique. They aren't cost levers themselves —
      they're what turns a technique into a number you can trust. Do these first, then work
      down the maturity levels.
    </p>
  </section>

  {
    FOUNDATIONS.map((f) => (
      <div class="foundation" id={f.slug}>
        <h3>{f.title}</h3>
        <p>{f.blurb}</p>
        <ul>
          {f.points.map((p: string) => <li set:html={p.replace(/`([^`]+)`/g, '<code>$1</code>')} />)}
        </ul>
      </div>
    ))
  }

  <section style="margin-top:28px;">
    <p style="color:var(--text-dim);">
      Set up? <a href={`${base}/techniques/`}>Start on the techniques →</a>
    </p>
  </section>
</BaseLayout>
